{
  "uid": "streampulse-live",
  "title": "StreamPulse — Live Streaming",
  "tags": [
    "streampulse",
    "live",
    "str-166",
    "str-244"
  ],
  "schemaVersion": 39,
  "editable": false,
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "15s",
  "links": [
    {
      "type": "link",
      "title": "API Backend",
      "url": "/d/streampulse-api",
      "icon": "dashboard",
      "tooltip": "Latences, erreurs et volumétrie HTTP côté API",
      "keepTime": true,
      "targetBlank": false,
      "asDropdown": false,
      "includeVars": false,
      "tags": []
    },
    {
      "type": "link",
      "title": "Logs & Erreurs",
      "url": "/d/streampulse-logs",
      "icon": "dashboard",
      "tooltip": "Journaux corrélés, erreurs cliquables vers Tempo",
      "keepTime": true,
      "targetBlank": false,
      "asDropdown": false,
      "includeVars": false,
      "tags": []
    },
    {
      "type": "link",
      "title": "Infrastructure",
      "url": "/d/streampulse-infra",
      "icon": "dashboard",
      "tooltip": "CPU, mémoire et goroutines de la machine",
      "keepTime": true,
      "targetBlank": false,
      "asDropdown": false,
      "includeVars": false,
      "tags": []
    }
  ],
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Métier — audience et continuité des diffusions",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": [],
      "description": "Ce que vivent les auditeurs et les diffuseurs. Les incidents lus ici se comptent en écoutes perdues, pas en codes HTTP — c'est la séparation que demande le sujet, portée sur un seul dashboard (STR-244)."
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Flux en direct",
      "description": "Lu à chaque scrape depuis le registre de sessions (GaugeFunc, ADR 022) : la valeur dérive de l'état réel et ne peut pas diverger.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "streampulse_live_streams_active"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Auditeurs (estimé, total)",
      "description": "Estimation : fréquence de demande du manifeste × durée d'un segment (10 s). HLS n'a pas de connexion persistante, deux auditeurs derrière une même adresse comptent pour un (ADR 025).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "round(sum(rate(streampulse_hls_requests_total{kind=\"playlist\",status=\"200\"}[2m])) * 10)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Débit sortant HLS",
      "description": "Octets de manifestes et de segments servis aux auditeurs, convertis en bits/s (STR-244). Ne compte pas le push d'ingest du diffuseur : celui-ci arrive dans le corps de requête, que le compteur n'observe pas.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_response_bytes_total{path=~\"/api/streams/\\\\{id\\\\}/(playlist.m3u8|segments/\\\\{segment\\\\})\"}[5m])) * 8"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Départs d'auditeurs",
      "description": "Auditeurs dont la fenêtre d'activité a expiré alors que le flux diffusait toujours. Fermeture volontaire du lecteur et coupure réseau expirent de la même façon : la métrique mesure des départs, pas des « déconnexions brutales » (ADR 041). Les auditeurs d'une diffusion qui se termine normalement ne sont jamais comptés ici.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(streampulse_listener_departures_total[5m])) * 60"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cpm"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Auditeurs estimés par flux",
      "description": "Même estimation que la statistique globale, détaillée par diffusion. Les séries disparaissent à l'arrêt du flux (ForgetStream, ADR 022).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "round(sum by (stream_id) (rate(streampulse_hls_requests_total{kind=\"playlist\",status=\"200\"}[2m])) * 10)",
          "legendFormat": "{{stream_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Débit de streaming (bits/s)",
      "description": "Volume réellement écrit vers les clients. L'écart entre les deux courbes est ce que consomme l'API hors diffusion (JSON, upload de pistes servi, documentation).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_response_bytes_total{path=~\"/api/streams/\\\\{id\\\\}/(playlist.m3u8|segments/\\\\{segment\\\\})\"}[5m])) * 8",
          "legendFormat": "HLS (manifestes + segments)"
        },
        {
          "refId": "B",
          "expr": "sum(rate(http_response_bytes_total[5m])) * 8",
          "legendFormat": "Toutes routes"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Interruptions de diffusion (15 min glissantes)",
      "description": "Diffusions terminées sans que le diffuseur l'ait demandé. ingest_timeout : plus aucun push audio pendant le délai de grâce — côté diffuseur. segmenter_failed : ffmpeg s'est arrêté seul — côté serveur. Les deux n'appellent pas la même intervention, d'où le label.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (increase(streampulse_stream_interruptions_total[15m]))",
          "legendFormat": "{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Coupures de diffusion rétablies (15 min glissantes)",
      "description": "Coupures d'ingest dont le diffuseur s'est remis avant l'expiration du bail. Le pendant rétabli du panneau des interruptions : celles-ci ne terminent aucune diffusion, donc elles n'y apparaissent pas. C'est pourtant l'incident le plus fréquent en mobilité, et celui qui fait perdre de l'audio au diffuseur — l'auditeur, lui, ne voit rien tant que son tampon absorbe la coupure.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 25
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(streampulse_ingest_recoveries_total[15m])",
          "legendFormat": "reprises"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Durée des coupures rétablies (p50 / p95)",
      "description": "Combien de temps le diffuseur a perdu à chaque coupure. Le compteur dit « combien de fois », cet histogramme dit « combien de temps » — une moyenne confondrait un hoquet d'une seconde et une coupure de trente. Les bornes s'arrêtent au bail d'ingest : au-delà, la diffusion se termine et bascule dans les interruptions.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(streampulse_ingest_outage_seconds_bucket[15m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(streampulse_ingest_outage_seconds_bucket[15m])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 200,
      "type": "row",
      "title": "Technique — santé du service HLS",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 25
      },
      "panels": [],
      "description": "Le versant infrastructure : latence, codes d'erreur, saturation. Un incident ici n'est pas forcément visible d'un auditeur, et un incident métier ci-dessus peut se produire sans qu'aucune de ces courbes ne bouge."
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Latence HLS p95",
      "description": "95e centile du temps de service des manifestes et segments.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 0,
        "y": 26
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{path=~\"/api/streams/\\\\{id\\\\}/(playlist.m3u8|segments/\\\\{segment\\\\})\"}[5m])))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Taux d'erreurs segments .ts",
      "description": "Part des requêtes de segments en échec (4xx/5xx). 206 Partial Content (requêtes Range des players) et 304 Not Modified sont des réponses normales, exclues du numérateur.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 4,
        "y": 26
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(streampulse_hls_requests_total{kind=\"segment\",status=~\"4..|5..\"}[5m])) or vector(0)) / clamp_min(sum(rate(streampulse_hls_requests_total{kind=\"segment\"}[5m])), 0.001)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.02
              },
              {
                "color": "red",
                "value": 0.1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Requêtes HLS par seconde (playlist / segment)",
      "description": "Débit de requêtes servies aux auditeurs, par nature.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (rate(streampulse_hls_requests_total[5m]))",
          "legendFormat": "{{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Erreurs HLS par seconde et par status (4xx/5xx)",
      "description": "Erreurs de lecture, détaillées par code.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(streampulse_hls_requests_total{status=~\"4..|5..\"}[5m]))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Rejets de capacité HLS (503)",
      "description": "Requêtes refusées par le limiteur HLS_MAX_CONCURRENT (STR-88). Un 503 ici n'est pas une panne : c'est la protection qui fonctionne, mais des auditeurs n'ont pas été servis.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 41
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (path) (rate(http_requests_total{path=~\"/api/streams/\\\\{id\\\\}/(playlist.m3u8|segments/\\\\{segment\\\\})\",status=\"503\"}[5m]))",
          "legendFormat": "{{path}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    }
  ]
}
