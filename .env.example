# ============================================================
# StreamPulse — Variables d'environnement
# ============================================================
# Copier ce fichier en .env avant le premier lancement :
#   cp .env.example .env
#
# IMPORTANT : Ne jamais committer le fichier .env
# Ce fichier (.env.example) est versionné et ne contient
# aucune valeur secrète réelle.
#
# Documentation complète : voir le README, section
# "Variables d'environnement".
# ============================================================

# --- Environnement ---
# development | production | test
GO_ENV=development

# --- API Go ---
API_PORT=8080

# --- Base de données PostgreSQL (consommée par l'API) ---
# DB_HOST=postgres en compose, localhost en dev natif.
DB_HOST=localhost
DB_PORT=5432
DB_USER=streampulse
DB_PASSWORD=changeme
DB_NAME=streampulse_db

# --- Base de données PostgreSQL (consommée par le conteneur Postgres) ---
# Doit refléter DB_USER / DB_PASSWORD / DB_NAME ci-dessus.
POSTGRES_USER=streampulse
POSTGRES_PASSWORD=changeme
POSTGRES_DB=streampulse_db
# Mode TLS de la connexion PostgreSQL. `disable` convient au réseau interne
# Docker ; une base managée exigera `require` ou `verify-full`.
DB_SSLMODE=disable

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=changeme
# Destinataire des alertes Grafana (STR-244). En développement, laisser tel
# quel : tout part dans Mailpit (http://localhost:8025) et rien ne sort de la
# machine. En production, mettre l'adresse réelle de l'équipe — sans quoi les
# alertes visent un domaine .invalid (RFC 2606) et ne sont jamais délivrées.
ALERT_EMAIL_TO=alertes@streampulse.invalid

# Webhook Discord des alertes Grafana. Second canal, en plus de l'email : c'est
# celui que l'équipe lit réellement.
#
# Le créer dans Discord : Paramètres du serveur → Intégrations → Webhooks →
# Nouveau webhook → choisir le salon → « Copier l'URL du webhook ».
#
# ⚠️ C'est un SECRET : qui détient cette URL peut publier dans le salon. Elle ne
# doit jamais être committée — `.env` est ignoré par git, et les scans gitleaks
# de la CI la rejetteraient. La transmettre par un canal privé, jamais dans une
# issue ou une pull request.
#
# Laisser vide est sans danger : le compose substitue alors une URL sur le TLD
# réservé .invalid, jamais résolvable. Les alertes partent par email seul, et
# l'envoi Discord échoue de son côté sans bloquer quoi que ce soit — la ligne
# apparaît en erreur dans Grafana → Alerting → Contact points, ce qui est le
# signe attendu d'un canal non configuré. Aucun déploiement n'échoue.
#
# ⚠️ Ne PAS remplacer la valeur par défaut du compose par une chaîne vide :
# Grafana exige une url non vide pour un receiver discord et refuserait de
# démarrer, entraînant l'email dans sa chute.
ALERT_DISCORD_WEBHOOK=

# --- Sécurité ---
# Remplacer par une chaîne aléatoire longue (min. 32 caractères).
# Génération rapide : openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-secret-min-32-chars

# --- Connexion Google (« Sign in with Google ») ---
# Audience attendue des ID tokens Google : l'ID du **Client Web** OAuth du
# projet Google Cloud (Console → API et services → Identifiants). Vide =
# connexion Google désactivée (la route /api/auth/google n'est pas montée).
# Le client mobile passe ce même ID en serverClientId pour que l'audience du
# jeton corresponde côté serveur.
GOOGLE_CLIENT_ID=

# --- Email (SMTP) ---
# Deux modes :
#
# Option 1 — Mailpit, défaut de développement :
#   Il tourne déjà dans docker-compose.yml, sans authentification.
#   Les emails ne sortent pas de la machine et se lisent sur
#   http://localhost:8025 — c'est le chemin décrit par le workflow de
#   réinitialisation de mot de passe (cf. CLAUDE.md).
#
# Option 2 — Relay externe (Mailgun, SendGrid, OVH, Gmail…) :
#   Renseigner les quatre champs avec les credentials du relay.
#
# ⚠️ SMTP_HOST vide n'est plus un mode utilisable :
#   - en production, la configuration refuse de démarrer. Sans relay, le jeton
#     de réinitialisation partirait dans les logs, donc dans Loki, indexé et
#     conservé sans limite — quiconque les lit prendrait la main sur n'importe
#     quel compte en ayant demandé une.
#   - en développement, le lien n'est plus écrit dans les logs pour la même
#     raison ; il ne s'affiche que sur la sortie console lisible (LOG_PRETTY),
#     qui n'est jamais active en conteneur. Utilisez Mailpit.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@streampulse.com

# URL de base de l'application — utilisée dans les liens d'email.
# Mobile (dev + prod) : schéma URL custom intercepté par l'app Flutter.
#   → Le lien email s'ouvrira directement dans l'app via deep link.
# Web (futur) : https://streampulse.com
APP_BASE_URL=streampulse://app

# CORS — origines autorisées (séparées par des virgules) pour les appels
# cross-origin (Flutter web, front web). En développement, les origines
# localhost / 127.0.0.1 sont autorisées d'office quel que soit le port ;
# cette variable sert surtout en production.
# Ex. : https://app.streampulse.com,https://streampulse.com
CORS_ALLOWED_ORIGINS=

# --- Streaming ---
# Préfixe de l'URL de stream source renvoyée au diffuseur (cf. ADR 013) :
#   {STREAM_INGEST_BASE_URL}/api/streams/ingest/{stream_key}
# En prod, pointer vers l'endpoint d'ingest public.
STREAM_INGEST_BASE_URL=http://localhost:8080

# --- Stockage des pistes audio (US-05-01, ADR 032) ---
# Répertoire racine où l'API écrit les fichiers audio uploadés, hors répertoire
# servi. En Docker, monté sur le volume track_storage (défaut /data/tracks) ;
# en `go run` local, un chemin relatif au repo (défaut ./data/tracks).
STORAGE_PATH=/data/tracks

# Nombre max de requêtes HLS (playlist + segments) servies simultanément aux
# auditeurs — STR-88. 0 = illimité.
HLS_MAX_CONCURRENT=256

# Délai sans audio avant l'arrêt automatique d'un live et timeout de chaque
# tentative d'arrêt persistant. Le premier doit dépasser le backoff mobile max
# de 30 s afin de laisser une reconnexion aboutir — l'API refuse de démarrer
# avec une valeur inférieure ou égale.
INGEST_RECONNECT_GRACE_SECONDS=45
INGEST_STOP_TIMEOUT_SECONDS=10

# Autorise la lecture de X-Forwarded-For pour identifier les auditeurs d'un flux
# (comptage d'audience, STR-154 / ADR 025).
#
# À laisser à false en local : l'en-tête est falsifiable, et sans reverse proxy
# devant, n'importe qui gonflerait le compteur d'un flux en variant sa valeur.
# À passer à true UNIQUEMENT en production, derrière Caddy qui le réécrit —
# sinon tous les auditeurs partagent l'adresse du proxy et le compteur sature à 1.
TRUST_PROXY_HEADERS=false

# Timeouts du serveur HTTP, en secondes. Les chemins longs (ingest audio, SSE)
# ne s'en remettent pas à ces valeurs : ils gèrent leurs propres échéances.
HTTP_READ_TIMEOUT_SECONDS=5
HTTP_WRITE_TIMEOUT_SECONDS=10
HTTP_IDLE_TIMEOUT_SECONDS=120

# Niveau minimal des logs structurés JSON (STR-163, ADR 018) :
# trace | debug | info | warn | error | fatal | panic
LOG_LEVEL=info

# Sortie console lisible pour le `go run` local UNIQUEMENT — ne jamais activer
# en conteneur : la collecte Loki attend du JSON (STR-172).
# LOG_PRETTY=true

# Endpoint OTLP/HTTP de Tempo pour les traces OpenTelemetry (STR-164, ADR 020).
# Vide = tracing désactivé (cas du `go run` local hors Docker).
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318
