# ============================================================
# StreamPulse — Variables d'environnement
# ============================================================
# Copier ce fichier en .env avant le premier lancement :
#   cp .env.example .env
#
# IMPORTANT : Ne jamais committer le fichier .env
# Ce fichier (.env.example) est versionné et ne contient
# aucune valeur secrète réelle.
#
# Documentation complète : voir le README, section
# "Variables d'environnement".
# ============================================================

# --- Environnement ---
# development | production | test
GO_ENV=development

# --- API Go ---
API_PORT=8080

# --- Base de données PostgreSQL (consommée par l'API) ---
# DB_HOST=postgres en compose, localhost en dev natif.
DB_HOST=localhost
DB_PORT=5432
DB_USER=streampulse
DB_PASSWORD=changeme
DB_NAME=streampulse_db

# --- Base de données PostgreSQL (consommée par le conteneur Postgres) ---
# Doit refléter DB_USER / DB_PASSWORD / DB_NAME ci-dessus.
POSTGRES_USER=streampulse
POSTGRES_PASSWORD=changeme
POSTGRES_DB=streampulse_db
DATABASE_URL=pgx5://streampulse:changeme@postgres:5432/streampulse_db?sslmode=disable

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=changeme

# --- Sécurité ---
# Remplacer par une chaîne aléatoire longue (min. 32 caractères).
# Génération rapide : openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-secret-min-32-chars

# --- Email (SMTP) ---
# Trois modes disponibles :
#
# Option 1 — Log stdout uniquement (aucun relay) :
#   Laisser SMTP_HOST vide. Les tokens apparaissent dans les logs Go.
#   SMTP_HOST=
#
# Option 2 — Mailpit (test local, recommandé) :
#   Démarrer : docker compose up -d mailpit
#   Interface web : http://localhost:8025
#   SMTP_HOST=mailpit  SMTP_PORT=1025  (pas d'authentification)
#
# Option 3 — Relay externe (Mailgun, SendGrid, OVH, Gmail…) :
#   Renseigner les 4 champs ci-dessous avec les credentials du relay.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@streampulse.com

# URL de base de l'application — utilisée dans les liens d'email.
# Mobile (dev + prod) : schéma URL custom intercepté par l'app Flutter.
#   → Le lien email s'ouvrira directement dans l'app via deep link.
# Web (futur) : https://streampulse.com
APP_BASE_URL=streampulse://app

# CORS — origines autorisées (séparées par des virgules) pour les appels
# cross-origin (Flutter web, front web). En développement, les origines
# localhost / 127.0.0.1 sont autorisées d'office quel que soit le port ;
# cette variable sert surtout en production.
# Ex. : https://app.streampulse.com,https://streampulse.com
CORS_ALLOWED_ORIGINS=
